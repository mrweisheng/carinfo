{
  "proxies": [
    {
      "http": "socks5://your_username:your_password@your_proxy_host:1080",
      "https": "socks5://your_username:your_password@your_proxy_host:1080",
      "name": "my_socks5_proxy",
      "enabled": true
    },
    {
      "http": "http://your_username:your_password@your_proxy_host:8080",
      "https": "http://your_username:your_password@your_proxy_host:8080",
      "name": "my_http_proxy",
      "enabled": true
    }
  ],
  "retry_settings": {
    "max_retries": 3,
    "retry_delay": 5,
    "timeout": 30
  },
  "fallback_to_direct": true
}