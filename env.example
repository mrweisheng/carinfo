# 数据库配置（PostgreSQL）
DB_HOST=your_db_host_here
DB_PORT=5432
DB_USER=your_db_user_here
DB_PASSWORD=your_password_here
DB_NAME=your_db_name_here

# 智能搜索：MiniMax 国内版 API key
# **唯一来源** —— config.json 里不再有 api_key 字段，密钥只走这里
# 不填则解析层自动降级为规则解析（别名表 + 正则），功能不瘫，只是语义理解变弱
MINIMAX_API_KEY=

# 检索服务的请求头鉴权（HTTP API 与 MCP-over-HTTP 共用同一个 X-API-Key）
# 生成：python -c "import secrets;print(secrets.token_urlsafe(32))"
# 不填 = 服务对任何请求都返回 503（刻意的 fail-closed，别让它悄无声息地裸奔）；
# 本机调试想彻底关掉鉴权就设 SEARCH_ALLOW_NO_AUTH=1，且**不要**让端口暴露在公网
SEARCH_API_KEY=
SEARCH_ALLOW_NO_AUTH=

# 检索服务的数据库连接池大小（每进程），默认 10
# 预算：服务端 max_connections=100；HTTP API 与 MCP 各 10 也才 20
# DB_POOL_SIZE=10
