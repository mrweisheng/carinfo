# 数据库配置
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=1qaz!QAZ2wsx@WSX
MYSQL_DATABASE=car_info_db

# 应用配置
PYTHONUNBUFFERED=1
TZ=Asia/Hong_Kong

# 日志配置
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(levelname)s - %(message)s

# 爬虫配置
SCRAPER_DELAY_MIN=1
SCRAPER_DELAY_MAX=3
ANTI_CRAWLER_DELAY_MIN=30
ANTI_CRAWLER_DELAY_MAX=60

# API配置（如果使用webhook服务）
API_HOST=0.0.0.0
API_PORT=5000
API_DEBUG=false

# 代理配置文件路径
PROXY_CONFIG_FILE=/app/proxy_config.json

# 主配置文件路径
CONFIG_FILE=/app/config.json

# 输出目录
CSV_OUTPUT_DIR=/app/csv_output
DEBUG_PAGES_DIR=/app/debug_pages
LOGS_DIR=/app/logs
